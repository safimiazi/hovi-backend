# ─── Copy this to .env.production on your VPS and fill in real values ────────
# NEVER commit .env.production to git

NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://kinedeo.com

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/kinedeo?retryWrites=true&w=majority

JWT_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_REFRESH_EXPIRATION=7d

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

SMS_PROVIDER=your_provider
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=KINEDEO

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

SSL_COMMERZ_STORE_ID=your_store_id
SSL_COMMERZ_STORE_PASSWORD=your_store_password
SSL_COMMERZ_ENVIRONMENT=live

FRONTEND_BASE_URL=https://kinedeo.com
BACKEND_BASE_URL=https://api.kinedeo.com/api
COOKIE_DOMAIN=.kinedeo.com

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong_random_password>

GHCR_OWNER=your_github_username

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_BASE_URL=https://api.pathao.com
