# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# IMPORTANT: Change to "production" before deploying
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# IMPORTANT (production only): Set to your root domain so the refresh token
# cookie is shared across subdomains (e.g. ".KineDeo.com").
# Leave empty in development.
COOKIE_DOMAIN=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hovi?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Use strong random secrets in production (min 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-a-different-strong-random-secret-in-production
JWT_REFRESH_EXPIRATION=7d

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── SMS Provider ─────────────────────────────────────────────────────────────
# "console" = dev mode (OTP logged to console, NOT sent via SMS)
# Set to your provider name in production (e.g. "msg91", "twilio")
SMS_PROVIDER=console
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=HOVI

# ─── File Storage (Cloudinary) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── SSLCommerz Payment Gateway ───────────────────────────────────────────────
SSL_COMMERZ_STORE_ID=your_store_id
SSL_COMMERZ_STORE_PASSWORD=your_store_password
# Change to "live" for production payments
SSL_COMMERZ_ENVIRONMENT=sandbox

# ─── Application URLs ─────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:4000/api

# Pathao Courier Integration
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_BASE_URL=https://hermes-api.p-stageenv.xyz
